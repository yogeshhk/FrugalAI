# Generated caches and downloads (rebuilt by the project commands)
code/quantum-wiki/models/
code/quantum-wiki/parsed/embeddings.json
code/quantum-wiki/parsed/curriculum.json
code/workflow-agent/cache/
code/finetune-slm/results/gate_*.json
code/finetune-slm/merged/
code/finetune-slm/models/
# finetune-slm: a leftover resume marker, and the text of the author's Marathi book (Sahaj Jeevan): raw passages,
# training pairs and model answers that quote it. The licence of the source book is unconfirmed, so only the
# questions (eval/mr_test_questions.json) and the metrics (results/mr_summary.csv) are published.
code/finetune-slm/adapters/*/state.json
code/finetune-slm/data/train_mr.jsonl
code/finetune-slm/data/qa_mr.json
code/finetune-slm/results/mr_answers_*.jsonl
# voice-form: models, the author's voice recordings (personal data), machine-voice smoke audio (CC BY-NC),
# the local outbox the sinks write to, and run logs
code/voice-form/models/*
!code/voice-form/models/README.md
code/voice-form/eval/audio/
code/voice-form/eval/smoke_audio/
code/voice-form/outbox/
code/voice-form/results/*_log.txt
# workflow-agent: model-written drafts that imitate the author's private QCNP FAQ entries (they can come close to the
# real text), so they stay local; the scores are published in results/drafts_summary.csv
code/workflow-agent/results/drafts_leave_one_out*.jsonl

# Local scratch
scratch/
*.log
.claude/settings.local.json
